# Application
PORT=5173
PUBLIC_URL=http://localhost:5173
VITE_API_BASE_URL=/api
NODE_ENV=development

# MySQL 8 / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Authentication
AUTH_SECRET=change-this-to-a-long-random-secret-before-production
AUTH_TOKEN_DAYS=7
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Optional SMTP. Required if email verification/password-reset email is enabled in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Portfolio <no-reply@example.com>

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=6


VITE_GOOGLE_AUTH_ENABLED=false
DB_SSL=false